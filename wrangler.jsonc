{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "target-coaching-website-updated",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ADMIN_USERNAME": "targetadmin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "target-coaching-db",
      "database_id": "target-coaching-db"
    }
  ]
}

