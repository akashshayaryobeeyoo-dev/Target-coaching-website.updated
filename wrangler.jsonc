{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "target-coaching-website-updated",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "target-photos"
    }
  ]
  // D1 Database Binding:
  // To avoid deployment error [code: 10021], database_id must be a real Cloudflare D1 UUID.
  // Once you obtain your D1 Database ID from Cloudflare (see instructions), you can uncomment
  // the block below, OR simply bind it via Cloudflare Dashboard -> Settings -> Bindings.
  /*
  ,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "target_coaching_db",
      "database_id": "<YOUR_D1_DATABASE_UUID>"
    }
  ]
  */
}
