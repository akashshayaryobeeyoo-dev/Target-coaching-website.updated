{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "target-coaching-website-updated",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ADMIN_USERNAME": "targetadmin"
  }
  // Free-Tier Configuration (100% Free - No Credit Card or Payment Method Required):
  // 1. Cloudflare R2 is removed because R2 requires payment authorization on Cloudflare.
  //    Ashvani Sir's official photograph is served as a zero-cost static asset (/ashvani-sir.png).
  // 2. Cloudflare D1 Database is 100% free with no credit card required.
  //    To enable persistent D1 database storage for inquiries, settings, and notices:
  //    Bind in Cloudflare Dashboard: Settings -> Bindings -> Add -> D1 database (Variable: DB)
  //    OR uncomment the block below with your actual D1 Database ID (UUID):
  /*
  ,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "target_coaching_db",
      "database_id": "<YOUR_D1_DATABASE_UUID>"
    }
  ]
  */
}
